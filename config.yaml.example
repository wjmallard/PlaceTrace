# location-history Configuration

# Database Settings
databases:
  main: location_history           # Main database
  osm: osm_boundaries              # OSM boundaries for geocoding

# Source Data
source_data:
  location_history_json: /path/to/location-history.json
  # arc_export_dir: /path/to/Arc App/Export/JSON/Daily  # Optional Arc app daily exports

# Trip Detection Settings
trips:
  detection:
    min_distance_km: 80             # Must be this far from home to be a trip
    max_gap_hours: 8                # Gap between visits to split trip
    extended_gap_hours: 24          # Allow longer gaps if far from home
    extended_gap_min_distance_km: 80
  categories:
    - name: Day Trip                # Quick excursions - there and back in a day
      emoji: 🚗
      min_hours: 4
      max_hours: 16
    - name: Short Trip              # Weekend getaways and short breaks (1-4 days)
      emoji: ✈️
      min_hours: 16
      max_hours: 96
    - name: Long Trip               # Extended travel (4+ days)
      emoji: 🌍
      min_hours: 96
      max_hours: null

# Processing Settings
processing:
  num_workers: 16  # Number of parallel workers for geocoding

# Map Display Settings
map:
  default_center:                   # Where the map opens before any data loads
    lat: 37.7749
    lon: -122.4194
  default_zoom: 10
  tiles:
    url: 'https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}'
    attribution: 'Tiles &copy; Esri'
