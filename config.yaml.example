# PlaceTrace Configuration

# Database Settings
databases:
  main: placetrace                 # Main database
  osm: osm_boundaries              # OSM boundaries for geocoding

# Source Data
source_data:
  location_history_json: /path/to/location-history.json

# Trip Detection Settings
trips:
  detection:
    min_distance_km: 80             # Must be this far from home to be a trip
    max_gap_hours: 8                # Gap between visits to split trip
    extended_gap_hours: 24          # Allow longer gaps if far from home
    extended_gap_min_distance_km: 80
  categories:
    - name: Day Trip
      emoji: 🚗
      color: lightblue
      min_hours: 4
      max_hours: 16
      description: Quick excursions - there and back in a day
    - name: Short Trip
      emoji: ✈️
      color: blue
      min_hours: 16
      max_hours: 96
      description: Weekend getaways and short breaks (1-4 days)
    - name: Long Trip
      emoji: 🌍
      color: darkblue
      min_hours: 96
      max_hours: null
      description: Extended travel (4+ days)

# Processing Settings
processing:
  num_workers: 16  # Number of parallel workers for geocoding

# Map Display Settings
map:
  height: 1200
  default_zoom: 12
  default_date_range_days: 7  # Default number of days to show
  tiles:
    url: 'https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}'
    attribution: 'Esri'
